datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  super_admin
  admin
  teacher
}

enum StudentStatus {
  active
  promoted
  graduated
  withdrawn
  transferred
}

enum Relationship {
  Father
  Mother
  Guardian
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum TeacherAttendStatus {
  present
  absent
  late
  on_leave
}

enum PhotoAttendanceStatus {
  pending
  verified
  rejected
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum MemLogType {
  sabaq
  sabqi
  manzil
}

enum MemLogQuality {
  excellent
  good
  average
  weak
}

enum FeeFrequency {
  monthly
  termly
  yearly
  one_time
}

enum PaymentMethod {
  cash
  bank_transfer
  online
  other
}

enum DiscountType {
  fixed
  percent
}

enum PromotionOutcome {
  promoted
  retained
  graduated
  withdrawn
  transferred
}

enum PaymentProvider {
  paystack
  flutterwave
}

enum PaymentIntentStatus {
  pending
  success
  failed
  abandoned
}

enum ApplicationStatus {
  submitted
  shortlisted
  interviewed
  accepted
  rejected
  enrolled
}

enum ExpenseCategory {
  refreshment
  salary
  utilities
  maintenance
  supplies
  transport
  rent
  events
  other
}

enum IncomeCategory {
  donation
  grant
  fundraising
  rental
  other
}

enum SettingGroup {
  general
  school
  finance
  sms
}

enum SettingType {
  text
  number
  boolean
  select
  textarea
}

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  passwordHash        String
  role                Role     @default(teacher)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  taughtClasses       ClassTeacher[]
  teacherAttendances  TeacherAttendance[]
  leaveRequests       LeaveRequest[]      @relation("LeaveRequester")
  reviewedLeaves      LeaveRequest[]      @relation("LeaveReviewer")
  memorizationLogs    MemorizationLog[]
  memTargetsSet       MemorizationTarget[] @relation("TargetTeacher")
  memTargetsGraded    MemorizationTarget[] @relation("TargetGrader")
  auditLogs           AuditLog[]
  notifications       Notification[]
  recordedAttendances StudentAttendance[]
  feePayments         FeePayment[]
  promotionsProcessed Promotion[]
  profile             TeacherProfile?
  attendancePhotos    ClassAttendancePhoto[]
  expenses            Expense[]
  incomeEntries       IncomeEntry[]
}

model AcademicYear {
  id             String   @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())

  classes        ClassRoom[]
  students       Student[]
  memLogs        MemorizationLog[]
  memTargets     MemorizationTarget[]
  terms          Term[]
  promotionsFrom Promotion[]  @relation("FromYear")
  promotionsTo   Promotion[]  @relation("ToYear")
  feeStructures  FeeStructure[]
}

// A term (session) within an academic year. Nigerian schools run three, but the
// count is not fixed here — terms are managed records, so a school can add more.
model Term {
  id             String   @id @default(cuid())
  academicYearId String
  name           String
  order          Int
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())

  academicYear  AcademicYear         @relation(fields: [academicYearId], references: [id])
  feeStructures FeeStructure[]
  memTargets    MemorizationTarget[]

  @@unique([academicYearId, order])
  @@index([isCurrent])
}

model ClassRoom {
  id             String   @id @default(cuid())
  name           String
  description    String?
  capacity       Int?
  order          Int      @default(0)
  academicYearId String
  createdAt      DateTime @default(now())

  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id])
  teachers       ClassTeacher[]
  students       Student[]
  attendances    StudentAttendance[]
  feeAssignments FeeAssignment[]
  promotionsFrom Promotion[]     @relation("FromClass")
  promotionsTo   Promotion[]     @relation("ToClass")
  attendancePhotos ClassAttendancePhoto[]
}

model ClassTeacher {
  classId   String
  userId    String
  isPrimary Boolean   @default(false)

  class     ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
}

model Student {
  id              String        @id @default(cuid())
  admissionNumber String        @unique
  firstName       String
  lastName        String
  gender          String?
  dateOfBirth     DateTime?
  enrollmentDate  DateTime
  photoUrl        String?
  address         String?
  status          StudentStatus @default(active)
  currentClassId  String?
  academicYearId  String
  arrearsTerms    Int           @default(0) // terms owed from before this system (manually set by admin)
  arrearsNote     String?       // optional context, e.g. "2024/25 Term 2 & 3"
  scholarship     Boolean       @default(false) // on scholarship: excluded from fees / "apply to all paying"
  scholarshipNote String?       // optional context, e.g. "Full sponsor: XYZ Foundation"
  // Set by an admin ticking "printed" — the PDF can be opened any number of
  // times, so only a deliberate mark counts as "this letter has been printed".
  admissionLetterPrintedAt   DateTime?
  admissionLetterPrintedById String?   // User.id of the admin who marked it
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  currentClass    ClassRoom?    @relation(fields: [currentClassId], references: [id])
  academicYear    AcademicYear  @relation(fields: [academicYearId], references: [id])
  guardians       Guardian[]
  attendances     StudentAttendance[]
  feeAssignments  FeeAssignment[]
  feePayments     FeePayment[]
  feeDiscounts    FeeDiscount[]
  memorizationLogs MemorizationLog[]
  memTargets      MemorizationTarget[]
  promotions      Promotion[]
}

model Guardian {
  id           String       @id @default(cuid())
  studentId    String
  name         String
  phone        String?
  email        String?
  relationship Relationship
  isPrimary    Boolean      @default(false)

  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentAttendance {
  id           String           @id @default(cuid())
  studentId    String
  classId      String
  recordedById String
  date         DateTime         @db.Date
  status       AttendanceStatus
  note         String?

  student      Student   @relation(fields: [studentId], references: [id])
  class        ClassRoom @relation(fields: [classId], references: [id])
  recordedBy   User      @relation(fields: [recordedById], references: [id])

  @@unique([studentId, date])
}

model TeacherAttendance {
  id           String              @id @default(cuid())
  userId       String
  recordedById String
  date         DateTime            @db.Date
  arrivalTime  DateTime?
  status       TeacherAttendStatus
  note         String?

  user         User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model ClassAttendancePhoto {
  id             String                @id @default(cuid())
  userId         String                // teacher who uploaded
  classId        String
  photoUrl       String?               // public URL; nulled after purge
  photoPath      String?               // storage path for deletion; nulled after purge
  capturedAt     DateTime              // authoritative EXIF capture time
  attendanceDate DateTime              @db.Date
  status         PhotoAttendanceStatus @default(pending)
  verifiedById   String?               // scalar, like TeacherAttendance.recordedById
  verifiedAt     DateTime?
  reviewNote     String?
  photoDeletedAt DateTime?             // set when storage object purged
  createdAt      DateTime              @default(now())

  user  User      @relation(fields: [userId], references: [id])
  class ClassRoom @relation(fields: [classId], references: [id])

  @@index([status, attendanceDate])
  @@index([userId])
}

model TeacherProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  bio            String?
  photoUrl       String?
  specialization String?
  awardTitle     String?
  awardDesc      String?
  videoUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id           String      @id @default(cuid())
  userId       String
  startDate    DateTime
  endDate      DateTime
  reason       String
  status       LeaveStatus @default(pending)
  reviewedById String?
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())

  user         User  @relation("LeaveRequester", fields: [userId], references: [id])
  reviewedBy   User? @relation("LeaveReviewer", fields: [reviewedById], references: [id])
}

model Surah {
  id          Int    @id
  nameArabic  String
  nameEnglish String
  juzStart    Int
  ayahCount   Int

  logsFrom    MemorizationLog[] @relation("FromSurah")
  logsTo      MemorizationLog[] @relation("ToSurah")
  targetsFrom MemorizationTarget[] @relation("TargetFromSurah")
  targetsTo   MemorizationTarget[] @relation("TargetToSurah")
}

model MemorizationLog {
  id             String        @id @default(cuid())
  studentId      String
  teacherId      String
  academicYearId String
  logDate        DateTime      @db.Date
  type           MemLogType
  surahFromId    Int
  ayahFrom       Int
  surahToId      Int
  ayahTo         Int
  pages          Decimal       @db.Decimal(5, 2)
  quality        MemLogQuality
  notes          String?
  createdAt      DateTime      @default(now())

  student      Student      @relation(fields: [studentId], references: [id])
  teacher      User         @relation(fields: [teacherId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  surahFrom    Surah        @relation("FromSurah", fields: [surahFromId], references: [id])
  surahTo      Surah        @relation("ToSurah", fields: [surahToId], references: [id])

  @@index([studentId, logDate, type])
}

// Termly memorization. The class teacher sets one target per student per term
// (a portion of the Qur'an plus a page count), then at term end records the
// percentage the student actually achieved. The percentage is entered by the
// teacher — it is deliberately never derived from session logs.
//
// This replaces day-to-day MemorizationLog entries. Those rows are retained for
// historical reference but are no longer written or read.
model MemorizationTarget {
  id             String   @id @default(cuid())
  studentId      String
  termId         String
  academicYearId String
  teacherId      String

  // The portion to memorise this term.
  surahFromId Int
  ayahFrom    Int
  surahToId   Int
  ayahTo      Int
  targetPages Decimal @db.Decimal(6, 2)
  notes       String?

  // Filled in at the end of the term. Null until graded.
  achievedPercent Decimal?  @db.Decimal(5, 2)
  grade           String?   // derived from achievedPercent when graded
  remark          String?
  gradedAt        DateTime?
  gradedById      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student      Student      @relation(fields: [studentId], references: [id])
  term         Term         @relation(fields: [termId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  teacher      User         @relation("TargetTeacher", fields: [teacherId], references: [id])
  gradedBy     User?        @relation("TargetGrader", fields: [gradedById], references: [id])
  surahFrom    Surah        @relation("TargetFromSurah", fields: [surahFromId], references: [id])
  surahTo      Surah        @relation("TargetToSurah", fields: [surahToId], references: [id])

  @@unique([studentId, termId])
  @@index([termId])
  @@index([academicYearId])
}

model FeeStructure {
  id             String       @id @default(cuid())
  academicYearId String
  name           String
  amount         Decimal      @db.Decimal(10, 2)
  frequency      FeeFrequency
  isActive       Boolean      @default(true)
  isArrears      Boolean      @default(false) // reserved bucket for previous-terms arrears payments
  isRegistrationFee Boolean   @default(false) // reserved bucket auto-assigned to every new student at enrollment
  isFormFee      Boolean      @default(false) // reserved bucket auto-assigned to every new student at enrollment
  description    String?
  createdAt      DateTime     @default(now())

  // A termly fee is stored as one row per term, so each term carries its own
  // outstanding balance, discount and payments — that is what lets a parent pay
  // for a single term. `termId` is null for yearly / one_time / monthly fees.
  termId      String?
  // Shared by the sibling rows created from one termly fee, so the admin UI can
  // present them as a single fee and act on all terms at once.
  termGroupId String?

  academicYear AcademicYear    @relation(fields: [academicYearId], references: [id])
  term         Term?           @relation(fields: [termId], references: [id])
  assignments  FeeAssignment[]
  payments     FeePayment[]
  discounts    FeeDiscount[]

  @@index([termGroupId])
  @@index([termId])
}

model FeeAssignment {
  id             String   @id @default(cuid())
  feeStructureId String
  studentId      String?
  classId        String?
  createdAt      DateTime @default(now())

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  student      Student?     @relation(fields: [studentId], references: [id])
  class        ClassRoom?   @relation(fields: [classId], references: [id])
}

model FeePayment {
  id             String        @id @default(cuid())
  studentId      String
  feeStructureId String
  recordedById   String
  amountPaid     Decimal       @db.Decimal(10, 2)
  paymentDate    DateTime
  paymentMethod  PaymentMethod
  reference      String?
  period         String?
  note           String?
  createdAt      DateTime      @default(now())

  student      Student      @relation(fields: [studentId], references: [id])
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  recordedBy   User         @relation(fields: [recordedById], references: [id])
}

model FeeDiscount {
  id             String      @id @default(cuid())
  studentId      String
  feeStructureId String
  discountType   DiscountType
  value          Decimal     @db.Decimal(10, 2)
  reason         String?
  createdAt      DateTime    @default(now())

  student      Student      @relation(fields: [studentId], references: [id])
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])

  @@unique([studentId, feeStructureId])
}

model Promotion {
  id                 String          @id @default(cuid())
  studentId          String
  fromAcademicYearId String
  toAcademicYearId   String
  fromClassId        String?
  toClassId          String?
  outcome            PromotionOutcome
  processedById      String
  notes              String?
  createdAt          DateTime        @default(now())

  student          Student      @relation(fields: [studentId], references: [id])
  fromAcademicYear AcademicYear @relation("FromYear", fields: [fromAcademicYearId], references: [id])
  toAcademicYear   AcademicYear @relation("ToYear", fields: [toAcademicYearId], references: [id])
  fromClass        ClassRoom?   @relation("FromClass", fields: [fromClassId], references: [id])
  toClass          ClassRoom?   @relation("ToClass", fields: [toClassId], references: [id])
  processedBy      User         @relation(fields: [processedById], references: [id])

  @@unique([studentId, fromAcademicYearId])
}

model PaymentIntent {
  id                String              @id @default(cuid())
  reference         String              @unique
  provider          PaymentProvider
  guardianPhone     String?
  amount            Decimal             @db.Decimal(10, 2)
  items             Json
  status            PaymentIntentStatus @default(pending)
  providerReference String?
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Expense {
  id           String          @id @default(cuid())
  name         String
  category     ExpenseCategory @default(other)
  amount       Decimal         @db.Decimal(10, 2)
  expenseDate  DateTime
  note         String?
  recordedById String
  createdAt    DateTime        @default(now())

  recordedBy   User @relation(fields: [recordedById], references: [id])

  @@index([expenseDate])
  @@index([category])
}

model IncomeEntry {
  id           String         @id @default(cuid())
  source       String
  category     IncomeCategory @default(other)
  amount       Decimal        @db.Decimal(10, 2)
  incomeDate   DateTime
  note         String?
  recordedById String
  createdAt    DateTime       @default(now())

  recordedBy   User @relation(fields: [recordedById], references: [id])

  @@index([incomeDate])
  @@index([category])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  action        String
  auditableType String?
  auditableId   String?
  oldValues     Json?
  newValues     Json?
  description   String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([auditableType, auditableId])
  @@index([action])
  @@index([createdAt])
}

model Setting {
  id      String       @id @default(cuid())
  key     String       @unique
  value   String?
  group   SettingGroup
  label   String
  type    SettingType
  options Json?
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  data      Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  youtubeUrl  String
  eventDate   DateTime
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Online admission application submitted by a prospective student (public form).
// Self-contained: foreign keys are plain strings (no Prisma relations) so this
// model can be added without touching User/ClassRoom/Student/AcademicYear.
model Applicant {
  id               String            @id @default(cuid())
  fullName         String
  gender           String?
  maritalStatus    String?
  dateOfBirth      DateTime?
  residence        String?
  phone            String?
  hizbMemorized    Int?              // Number of Hizb memorized from the Qur'an
  formerSchool     String?
  reasonForLeaving String?
  guardianName     String?
  guardianPhone    String?
  photoUrl         String?           // passport photograph
  status           ApplicationStatus @default(submitted)
  interviewNotes   String?
  reviewedById     String?           // User.id of admin who reviewed
  academicYearId   String?           // year applying for
  assignedClassId  String?           // ClassRoom.id assigned on acceptance
  admissionNumber  String?           // issued on acceptance
  studentId        String?           // Student.id created on enrollment
  // Set by an admin ticking "printed" on the application form (see
  // Student.admissionLetterPrintedAt for the matching letter flag).
  applicationFormPrintedAt   DateTime?
  applicationFormPrintedById String?  // User.id of the admin who marked it
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Log of every SMS the system attempts to send (balance reminders, notifications).
// Rows are created even when SMS is not yet configured (status "skipped") so there
// is an audit trail and a queue that can be retried once an API key is added.
model SmsLog {
  id                String   @id @default(cuid())
  toPhone           String
  body              String
  purpose           String   // balance_reminder | notification | other
  studentId         String?
  status            String   @default("queued") // queued | sent | failed | skipped
  provider          String?
  providerReference String?
  error             String?
  createdById       String?
  createdAt         DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}
